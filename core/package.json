		"@hono/node-server": "^1.19.4",
		"@hono/zod-validator": "^0.7.3",
		"dotenv": "^17.2.2",
		"drizzle-orm": "^0.44.5",
		"fastify": "^5.6.0",
		"fastify-plugin": "^5.0.1",
		"hono": "^4.9.8",
		"install": "^0.13.0",
		"pg": "^8.16.3",
		"pino": "^9.9.4",
		"typescript": "^5.9.2",
		"zod": "^4.1.11"
	},
