{
  "name": "incident-buddy",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts",
      "nodeGypDependencies": false
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    }
  },
  "postCreateCommand": "curl https://mise.run | sh && echo 'eval \"$(~/.local/bin/mise activate bash)\"' >> ~/.bashrc && ~/.local/bin/mise trust && npm install -g pnpm && CI=true pnpm install",
  "postStartCommand": "docker network connect incident-buddy $(hostname) 2>/dev/null || true",
  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/root/.claude,type=bind,consistency=cached"
  ],
  "remoteEnv": {
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "http://jaeger:4318"
  },
  "appPort": [9080, 4000, 8888, 16686, 4318],
  "portsAttributes": {
    "9080": { "label": "Firestore Emulator" },
    "4004": { "label": "Firebase Emulator UI" },
    "8888": { "label": "API Server" },
		"4318": { "label": "OpenTelemetry Collector" },
		"16686": { "label": "Jaeger UI" }
  }
}
